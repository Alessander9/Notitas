# ============================================================
# Notitas API — imagen para Vercel (Docker / VCR)
# Vercel detecta automáticamente este archivo (Dockerfile.vercel)
# en el root directory del proyecto (backend/). Es una copia del
# Dockerfile estándar; Vercel exige el sufijo .vercel para
# auto-detectar el build de contenedor.
#
# Variables de entorno requeridas en runtime (Vercel env vars):
#   SPRING_PROFILES_ACTIVE=prod
#   DB_URL, DB_USER, DB_PASSWORD   (Supabase/PostgreSQL)
#   CORS_ALLOWED_ORIGINS          (https://notitas-cleo.vercel.app)
#   NOTITAS_JWT_SECRET            (secreto JWT propio)
#   PORT=8080                      (Vercel enruta tráfico a este puerto)
# ============================================================
FROM eclipse-temurin:17-jdk-alpine AS build
WORKDIR /app
COPY .mvn/ .mvn/
COPY mvnw pom.xml ./
# mvnw puede perder el bit de ejecución al clonar desde Windows
RUN chmod +x mvnw && ./mvnw -q -DskipTests dependency:go-offline
COPY src/ src/
RUN ./mvnw -q -DskipTests package

FROM eclipse-temurin:17-jre-alpine
WORKDIR /app
RUN addgroup -S notitas && adduser -S -G notitas notitas
COPY --from=build /app/target/*.jar app.jar
USER notitas
EXPOSE 8080
ENV SPRING_PROFILES_ACTIVE=prod
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75.0", "-jar", "/app/app.jar"]
