*.jks
*.keystore
secrets/
credentials.json

# --- Logs ---
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Editor y SO ---
.vscode/*
